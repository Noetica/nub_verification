{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run": {
      "type": "string",
      "minLength": 1
    },
    "pass": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "reviewer": {
      "enum": [
        "sonnet",
        "luna",
        "composer",
        "opus",
        "sol",
        "grok"
      ]
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "A": {
          "type": "boolean"
        },
        "B": {
          "type": "boolean"
        },
        "C": {
          "type": "boolean"
        },
        "D": {
          "type": "boolean"
        }
      },
      "required": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "finding",
              "could_not_verify"
            ]
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "lenses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ]
            }
          },
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "line",
                  "file",
                  "base",
                  "intent",
                  "change"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "value"
            ]
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "remedy": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "severity",
          "confidence",
          "lenses",
          "anchor",
          "trigger",
          "outcome",
          "evidence",
          "remedy"
        ]
      }
    },
    "advisory": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "run",
    "pass",
    "reviewer",
    "input",
    "coverage",
    "claims",
    "advisory"
  ]
}
